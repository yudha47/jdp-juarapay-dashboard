# Dashboard tidak memegang secret; nilai ini hanya URL/mode.
# File asli: .env.local (dev) — di-ignore git. Di server cukup lewat ENV Docker (lihat Dockerfile).

# Mode aplikasi: "normal" (prod) | "sandbox"
SIMULATOR=normal
NEXT_PUBLIC_SIMULATOR=normal

# URL backend core-api yang dipanggil server Next.js (BFF)
#   prod (docker network) : http://jdp-main-prod:8080
#   sandbox               : http://jdp-main-sandbox:8080  atau https://api-sandbox.juarapay.id
API_BASE_URL=http://jdp-main-prod:8080

# Origin dashboard, dikirim sebagai header Origin ke backend (harus sama dengan CORS_ALLOWED_ORIGIN core-api)
APP_ORIGIN=https://app.juarapay.id
